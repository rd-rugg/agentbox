#!/bin/sh
# Installed under every other hook name in the global hooks dir: core.hooksPath
# would otherwise hide the repository's own .git/hooks, so hand over to them.
# (`git rev-parse --git-path hooks` would point back here, so use the git dir.)
repo_hook="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/$(basename "$0")"
[ -x "$repo_hook" ] && [ "$(realpath "$repo_hook")" != "$(realpath "$0")" ] && exec "$repo_hook" "$@"
exit 0
