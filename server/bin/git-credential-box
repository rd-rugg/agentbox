#!/bin/sh
# git credential helper: answers GitHub requests with a token from github-token (the GitHub App's
# one-hour installation token when the app is in Bitwarden, else CLI__GH_TOKEN). Nothing is stored on disk.
[ "$1" = get ] || exit 0
host=
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  [ "$key" = host ] && host=$value
done
[ "$host" = github.com ] || exit 0
token=$(github-token 2>/dev/null) || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
