#!/usr/bin/env python3
"""Run a command with one app's secrets from Bitwarden Secrets Manager.

APP's secrets are found two ways, so either layout works in Bitwarden:
  - by name prefix: APP__NAME anywhere (e.g. API__DATABASE_URL), prefix stripped;
  - by project: every secret in a Bitwarden project named APP, names as they are
    (case doesn't matter; spaces in a project name count as "-").
When both give the same NAME, the prefixed secret wins. Any other name with two
different values, or an APP__NAME in a production project, stops with an error.

A secret named APP__FILE__NAME (or FILE__NAME inside APP's project) is a file:
its value is written to /run/agentbox/files/APP/NAME (RAM only, mode 600) and
NAME is set to that path, e.g. API__FILE__GOOGLE_APPLICATION_CREDENTIALS.

  secrets APP -- CMD [ARGS...]   run CMD with APP's secrets (e.g. secrets api -- npm run dev)
  secrets APP                    list the variable names APP would get (no values)
  secrets APP --files            write APP's file secrets and print their paths
  secrets APP --env-file PATH    write APP's variables as a .env in RAM and symlink PATH to it
                                 (for tools that insist on a file, e.g. docker compose env_file)
  secrets --apps                 list the apps available (prefixes and projects)
  secrets --refresh              reload from Bitwarden now (otherwise cached in RAM for 5 minutes)

Works on the box and on your laptop. The Bitwarden token comes from
/run/agentbox/bws.env on the box (RAM only, copied there by up.sh) and from
~/.config/agentbox/bws.env on the laptop. Cached values and file secrets live
in a RAM folder: /run/agentbox on the box, $XDG_RUNTIME_DIR/agentbox elsewhere.
"""
import json
import os
import re
import subprocess
import sys
import time

def ram_dir():
    """A RAM-backed folder of our own: /run/agentbox on the box, else under XDG_RUNTIME_DIR."""
    if os.environ.get("AGENTBOX_RUN"):
        return os.environ["AGENTBOX_RUN"]
    if os.access("/run/agentbox", os.W_OK):
        return "/run/agentbox"
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    if not os.path.isdir(base):
        # macOS has no per-user RAM folder; its per-user temp folder is private (0700).
        import tempfile
        base = tempfile.gettempdir()
    path = os.path.join(base, "agentbox")
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


RUN_DIR = ram_dir()
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
TOKEN_FILE = next((p for p in (f"{RUN_DIR}/bws.env",
                               os.path.join(CONFIG_HOME, "agentbox", "bws.env"),
                               os.path.join(CONFIG_HOME, "claude-box", "bws.env"))  # older name
                   if os.path.exists(p)), f"{RUN_DIR}/bws.env")
CACHE_FILE = f"{RUN_DIR}/cache.json"  # RAM only; avoids Bitwarden's rate limit
CACHE_TTL = 300  # seconds
FILE_MARK = "FILE__"


def load_token_env():
    if not os.path.exists(TOKEN_FILE):
        sys.exit("No Bitwarden token on this box. On your laptop, put BWS_ACCESS_TOKEN=... "
                 "(and BWS_SERVER_URL=https://vault.bitwarden.eu for the EU region) in "
                 "~/.config/agentbox/bws.env, then run up.sh.")
    env = {}
    with open(TOKEN_FILE) as fh:
        for line in fh:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env[k.strip()] = v.strip().strip("'\"")
    return env


def read_cache(max_age):
    """Cached [key, value, project] entries (an older cache format counts as missing)."""
    try:
        if time.time() - os.path.getmtime(CACHE_FILE) <= max_age:
            with open(CACHE_FILE) as fh:
                data = json.load(fh)
            if isinstance(data, dict) and data.get("v") == 2:
                return data["entries"]
    except (OSError, ValueError, KeyError):
        pass
    return None


def fetch_secrets(refresh=False):
    cached = None if refresh else read_cache(CACHE_TTL)
    if cached is not None:
        return cached
    env = dict(os.environ, **load_token_env())
    out = subprocess.run(["bws", "secret", "list", "--output", "json", "--color", "no"],
                         env=env, capture_output=True, text=True)
    if out.returncode != 0:
        stale = read_cache(24 * 3600)
        if stale is not None:
            print("secrets: Bitwarden unreachable, using the last copy", file=sys.stderr)
            return stale
        sys.exit(f"bws failed: {out.stderr.strip()[:300]}")
    # Project names, for the project layout (a token that can't list them still works by prefix).
    projects = subprocess.run(["bws", "project", "list", "--output", "json", "--color", "no"],
                              env=env, capture_output=True, text=True)
    names = {p["id"]: p["name"] for p in json.loads(projects.stdout)} if projects.returncode == 0 else {}
    entries = [[s["key"], s["value"], names.get(s.get("projectId"), "")] for s in json.loads(out.stdout)]
    fd = os.open(CACHE_FILE + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump({"v": 2, "entries": entries}, fh)
    os.replace(CACHE_FILE + ".tmp", CACHE_FILE)
    return entries


def prefix_of(app):
    return app.upper().replace("-", "_") + "__"


def app_of_project(project):
    """The app name a Bitwarden project answers to."""
    return "-".join(project.lower().replace("_", "-").split())


def apps(entries):
    return sorted({k.split("__", 1)[0].lower() for k, _, _ in entries if "__" in k}
                  | {app_of_project(p) for _, _, p in entries if p})


PROD_PROJECTS = re.compile(r"^(prod|production)([-_ ].*)?$|^.*[-_ ](prod|production)$", re.I)


def check_sources(app, by_project, by_prefix, only=None):
    """Stop rather than guess when APP's variable could come out wrong:
    - one variable (FILE__ marker stripped) with two different values, from two projects
      or twice in one, except one APP__NAME value overriding one value of the same name
      in APP's project (the documented precedence);
    - an APP__NAME (development name) kept in a production project: production values
      are APP_PROD__NAME, so `secrets app` never hands them out.
    Only names and project names are printed. ONLY limits the check to those variables."""
    def var(name):
        return name[len(FILE_MARK):] if name.startswith(FILE_MARK) else name
    sources = {}
    for layout, items in (("project", by_project), ("prefix", by_prefix)):
        for name, value, project in items:
            if only is None or var(name) in only:
                sources.setdefault(var(name), []).append((layout, value, project or "no project"))
    for name, found in sources.items():
        prod = sorted({p for layout, _, p in found if layout == "prefix" and PROD_PROJECTS.match(p)})
        if prod and not app.lower().replace("-", "_").endswith("_prod"):
            sys.exit(f"secrets: {prefix_of(app)}{name} is in the production project {', '.join(prod)}: production "
                     f"values are named {prefix_of(app + '_prod')}{name} (secrets {app}_prod), so `secrets {app}` "
                     "stays development. Rename it in Bitwarden.")
        values = {v for _, v, _ in found}
        if len(values) < 2:
            continue
        prefixed = {v for layout, v, _ in found if layout == "prefix"}
        if len(prefixed) == 1 and len({v for layout, v, _ in found if layout == "project"}) <= 1:
            continue   # one APP__NAME value over one value in APP's project: the prefixed one wins
        projects = sorted({p for _, _, p in found})
        where = f"Bitwarden projects {' and '.join(projects)}" if len(projects) > 1 else f"project {projects[0]}"
        hint = ("" if app.lower().replace("-", "_").endswith("_prod")
                else f" (production values are named {prefix_of(app + '_prod')}NAME)")
        sys.exit(f"secrets: {app} has different values for {name} ({where}). Keep one, or give one "
                 f"another name{hint}.")


def app_env(entries, app, write_files=True, only=None):
    """APP's variables: its project's secrets as named, then APP__NAME ones (which win)
    with the prefix stripped. File secrets become paths. Ambiguous or misplaced
    values stop it (check_sources); ONLY limits that check to those variables."""
    prefix, want = prefix_of(app), app_of_project(app)
    by_project = [(key, value, project) for key, value, project in entries
                  if project and app_of_project(project) == want]
    by_prefix = [(key[len(prefix):], value, project) for key, value, project in entries if key.startswith(prefix)]
    check_sources(app, by_project, by_prefix, only)
    pairs = [(n, v) for n, v, _ in by_project] + [(n, v) for n, v, _ in by_prefix]
    env = {}
    for name, value in pairs:
        if name.startswith(FILE_MARK):
            name = name[len(FILE_MARK):]
            path = os.path.join(RUN_DIR, "files", app.lower(), name)
            if write_files:
                os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
                fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, "w") as fh:
                    fh.write(value)
            value = path
        env[name] = value
    return env


def dotenv_quote(value):
    r"""VALUE quoted for a .env file so that docker compose, python-dotenv, bash's
    `source` and the workspace `secret` tool read it unchanged wherever they can.
    They disagree on escapes, so the value is written without any if possible:
    - Single quotes, as is: literal for all of them, `$` included (python-dotenv
      still expands `${...}` by default; see dotenv_caveat). Not for a `'`; nor a
      `\` before the closing quote (compose and python-dotenv read it as escaping
      the quote), `\\` (python-dotenv makes it `\`) or a newline (line readers).
    - Else double quotes, as is, when nothing in VALUE is special there (`$`, a
      backtick, `"`, `\`, a newline): typically a value with a `'` in it.
    - Else double quotes with compose's escapes (`\\`, `\"`, `\n`, `\$`; checked
      against compose 2.x and 5.x, which keeps an escaped backtick's `\`, so
      backticks stay as they are). Keeps a PEM key on one line, as before. Some
      readers get these changed: dotenv_caveat says which, and the writer warns."""
    if "'" not in value and "\\\\" not in value and not value.endswith("\\") and "\n" not in value:
        return "'" + value + "'"
    if not any(c in value for c in "$`\"\\\n"):
        return '"' + value + '"'
    return '"' + (value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
                  .replace("$", "\\$")) + '"'


def dotenv_caveat(value):
    """Why a reader other than docker compose may get VALUE changed, or None."""
    if "${" in value:
        return "python-dotenv's load_dotenv expands the ${...} in it"
    if dotenv_quote(value).startswith('"') and ("$" in value or value.endswith("\\")):
        return "python-dotenv reads it changed (it needs escapes there)"
    if "`" in value and dotenv_quote(value).startswith('"'):
        return "bash would run the part in backticks if the file were sourced"
    return None


def write_env_file(env, app, link):
    """Write env as a .env file in RAM and point `link` (e.g. ./.env) at it."""
    target = os.path.join(RUN_DIR, "files", app.lower(), "dotenv")
    os.makedirs(os.path.dirname(target), mode=0o700, exist_ok=True)
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.writelines(f"{k}={dotenv_quote(v)}\n" for k, v in sorted(env.items()))
    if os.path.lexists(link) and not os.path.islink(link):
        sys.exit(f"{link} is a real file; move it away first (its values belong in Bitwarden).")
    if os.path.islink(link):
        os.unlink(link)
    os.symlink(target, link)
    print(f"{link} -> {target} ({len(env)} variables, RAM only)")
    for k, v in sorted(env.items()):
        why = dotenv_caveat(v)
        if why:
            print(f"note: {k} in {link}: compose reads it exactly; {why}", file=sys.stderr)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    secrets = fetch_secrets(refresh=argv[0] == "--refresh")
    if argv[0] == "--refresh":
        print(f"{len(secrets)} secrets loaded")
        return

    if argv[0] == "--apps":
        print("\n".join(apps(secrets)))
        return
    # For helper scripts only (git credential helper, tool wrappers, commit guard).
    if argv[0] == "--get" and len(argv) == 3:
        value = app_env(secrets, argv[1], only={argv[2]}).get(argv[2])
        if value is None:
            sys.exit(1)
        sys.stdout.write(value)
        return
    if argv[0] == "--all-values":   # the commit guard: every value, keyed uniquely
        json.dump({f"{p}/{k}" if p else k: v for k, v, p in secrets}, sys.stdout)
        return

    app = argv[0]
    if len(argv) == 1:
        names = app_env(secrets, app, write_files=False)
        if not names:
            sys.exit(f"No secrets for {app} (named {prefix_of(app)}* or in a Bitwarden project {app}). See `secrets --apps`.")
        print("\n".join(sorted(names)))
        return
    if argv[1] == "--files":
        for name, path in sorted(app_env(secrets, app).items()):
            if path.startswith(RUN_DIR + "/files/"):
                print(f"{name}={path}")
        return
    if argv[1] == "--env-file" and len(argv) == 3:
        env = app_env(secrets, app)
        if not env:
            sys.exit(f"No secrets for {app} (named {prefix_of(app)}* or in a Bitwarden project {app}). See `secrets --apps`.")
        write_env_file(env, app, argv[2])
        return
    if argv[1] != "--" or len(argv) < 3:
        sys.exit("Usage: secrets APP -- CMD [ARGS...]")
    env = app_env(secrets, app)
    if not env:
        sys.exit(f"No secrets for {app} (named {prefix_of(app)}* or in a Bitwarden project {app}). See `secrets --apps`.")
    os.execvpe(argv[2], argv[2:], dict(os.environ, **env))


if __name__ == "__main__":
    main(sys.argv[1:])
